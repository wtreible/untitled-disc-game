{
  "name": "sat-golf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "course": "tsx scripts/build-course.ts",
    "disc-course": "tsx scripts/build-disc-course.ts",
    "silly-course": "tsx scripts/build-silly-course.ts",
    "fantasy-course": "tsx scripts/build-fantasy-course.ts",
    "rainbow-course": "tsx scripts/build-rainbow-course.ts",
    "pirate-course": "tsx scripts/build-pirate-course.ts",
    "tree-shapes": "tsx scripts/build-tree-shapes.ts",
    "slim-models": "tsx scripts/slim-models.ts",
    "course-summary": "tsx scripts/course-summary.ts",
    "server:dev": "wrangler dev --config server/wrangler.toml",
    "server:deploy": "wrangler deploy --config server/wrangler.toml",
    "server:typecheck": "tsc --noEmit -p server"
  },
  "dependencies": {
    "osmtogeojson": "^3.0.0-beta.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
